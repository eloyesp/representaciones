<h1>Reservas</h1>

<%= form_with url: reservas_path, method: :get do |form| %>
  <%= form.label :operadora_id, "Operadora" %>
  <%= form.collection_select :operadora_id, Operadora.all, :id, :name,
      { include_blank: "Todas" }, { value: params[:operadora_id] } %>
  <%= form.label :agency_id, "Agencia" %>
  <%= form.collection_select :agency_id, Agency.all, :id, :name,
      { include_blank: "Todas" }, { value: params[:agency_id] } %>
  <%= form.label :referencia, "Referencia" %>
  <%= form.text_field :referencia, value: params[:referencia] %>
  <%= form.submit "Filtrar" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Referencia</th>
      <th>Salida</th>
      <th>Operadora</th>
      <th>Agencia</th>
      <th>Pasajeros</th>
      <th>Total</th>
      <th>Estado</th>
    </tr>
  </thead>
  <tbody>
    <% @reservas.each do |reserva| %>
      <tr>
        <td><%= link_to reserva.id, reserva %></td>
        <td><%= reserva.referencia %></td>
        <td><%= reserva.salida %></td>
        <td><%= reserva.operadora&.name %></td>
        <td><%= reserva.agency&.name %></td>
        <td><%= reserva.pasajeros.size %></td>
        <td><%= reserva.total.format %></td>
        <td><%= estado_reserva(reserva) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%== pagy_nav(@pagy) %>